# NFSv2 Test Client - CentOS 6 (has NFSv2 kernel support)
FROM centos:6

# Use vault repos for EOL CentOS 6
RUN sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-Base.repo && \
    sed -i 's|mirrorlist=|#mirrorlist=|g' /etc/yum.repos.d/CentOS-Base.repo

# Install NFS client tools
RUN yum install -y nfs-utils rpcbind net-tools iputils && yum clean all

# Create mount point
RUN mkdir -p /mnt/nfsv2

# Test script
COPY <<'EOF' /test-nfsv2.sh
#!/bin/bash
set -e

SERVER_IP="$1"
if [ -z "$SERVER_IP" ]; then
    echo "Usage: $0 <nfs-server-ip>"
    exit 1
fi

echo "=========================================="
echo "NFSv2 Mount Test (CentOS 6)"
echo "=========================================="
echo "Server: $SERVER_IP"
echo ""

# Check connectivity
echo "[1/4] Testing connectivity..."
ping -c 2 "$SERVER_IP" && echo "✓ Server reachable" || exit 1
echo ""

# Check RPC
echo "[2/4] Checking RPC services..."
rpcinfo -p "$SERVER_IP"
echo ""

# Verify NFSv2
echo "[3/4] Verifying NFSv2..."
if rpcinfo -p "$SERVER_IP" | grep -q "100003.*2"; then
    echo "✓ NFSv2 available!"
else
    echo "✗ NFSv2 not found"
    exit 1
fi
echo ""

# Mount test
echo "[4/4] Mounting NFSv2..."
echo "Trying: mount -t nfs -o nfsvers=2,nolock,udp ${SERVER_IP}:/export /mnt/nfsv2"

# Try with nfsvers=2 (old style)
if mount -t nfs -o nfsvers=2,nolock,udp "${SERVER_IP}:/export" /mnt/nfsv2 2>/tmp/mount_err; then
    echo "✓ NFSv2 mount SUCCESSFUL!"
    echo ""
    
    echo "=========================================="
    echo "Testing Filesystem"
    echo "=========================================="
    
    # Show mount
    mount | grep nfsv2
    echo ""
    
    # Show filesystem
    df -h /mnt/nfsv2
    echo ""
    
    # List files
    echo "Directory listing:"
    ls -la /mnt/nfsv2/
    echo ""
    
    # Write test
    echo "Write test..."
    if echo "NFSv2 works!" > /mnt/nfsv2/test.txt 2>/dev/null; then
        echo "✓ Write successful!"
        cat /mnt/nfsv2/test.txt
        rm -f /mnt/nfsv2/test.txt
    else
        echo "⚠ Write failed (may be permissions)"
    fi
    echo ""
    
    echo "=========================================="
    echo "✅ NFSv2 FULLY FUNCTIONAL!"
    echo "=========================================="
    
    umount /mnt/nfsv2
    exit 0
else
    echo "✗ Mount with nfsvers=2 failed"
    cat /tmp/mount_err 2>/dev/null
    echo ""
    
    # Try basic mount without version (should negotiate)
    echo "Trying basic mount (let it negotiate)..."
    if mount -t nfs -o nolock "${SERVER_IP}:/export" /mnt/nfsv2 2>&1; then
        echo "✓ Mount successful (auto-negotiated)!"
        mount | grep nfsv2
        umount /mnt/nfsv2
        exit 0
    fi
    
    exit 1
fi
EOF

RUN chmod +x /test-nfsv2.sh

CMD ["/bin/bash"]

