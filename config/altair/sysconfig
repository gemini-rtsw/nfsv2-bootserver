# Altair boot server — host settings. Survives RPM upgrades (%config(noreplace)).
#
# Read by BOTH systemd (EnvironmentFile=) and docker (--env-file). docker's
# --env-file does NOT strip quotes, so never quote a value here.

NFS_EXPORT_DIR=/export
TFTP_ROOT=/export

VARIANT_LABEL=Altair / VxWorks

# CIDR:GATEWAY pairs, space separated. 'default' is just another route.
# ipvlan gives the container no default route of its own, so it must be set
# here or off-subnet clients cannot be replied to.
EXTRA_ROUTES=default:10.2.2.1 10.2.49.0/24:10.2.2.234 10.1.0.0/16:10.2.2.1

CONTAINER_IP=10.2.2.147
NETWORK_NAME=nfs-ipvlan
NETWORK_SUBNET=10.2.2.0/24
NETWORK_GATEWAY=10.2.2.1
PARENT_INTERFACE=ens33

# Altair-only. Clients rsh/rcp in as gemvx and address /gemini absolutely, so
# the container needs that link; its target is the bind-mounted export, so it
# is made at startup rather than baked into the image.
EXPORT_SYMLINKS=/gemini:/export/gemini

# Seeded so the tree exists with the right mode before any client mounts.
SEED_DIRS=/export/gemini/altair/V3-7gate

# Do NOT add a /gemini bind mount here the way the TCS variant does. Altair
# exports /export, which already contains gemini/, and EXPORT_SYMLINKS above
# points /gemini at it. A bind mount would shadow that symlink and show
# clients an empty tree instead. If a GEM8.6 package must be installed on this
# host, make the HOST's /gemini a symlink to /export/gemini so the RPM lands
# inside the exported tree.
