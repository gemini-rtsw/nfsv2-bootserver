# TCS boot server — host settings. Survives RPM upgrades (%config(noreplace)).
#
# Read by BOTH systemd (EnvironmentFile=) and docker (--env-file). docker's
# --env-file does NOT strip quotes, so never quote a value here.

NFS_EXPORT_DIR=/gem_sw

# TFTP is rooted at / because the VME bootloader requests the full path
# /gem_sw/prod/redirector/tcs-mk-ioc, not a path relative to the export.
TFTP_ROOT=/

VARIANT_LABEL=TCS / RTEMS VME

# CIDR:GATEWAY pairs, space separated. 'default' is just another route.
# ipvlan gives the container no default route of its own, so it must be set
# here or off-subnet clients cannot be replied to.
EXTRA_ROUTES=default:10.2.2.1 10.2.49.0/24:10.2.2.234 10.1.2.0/24:10.2.2.1

CONTAINER_IP=10.2.2.145
NETWORK_NAME=nfs-ipvlan
NETWORK_SUBNET=10.2.2.0/24
NETWORK_GATEWAY=10.2.2.1
PARENT_INTERFACE=ens33

# gmoscc (and the other GEM8.6 instrument packages) install to /gemini on the
# HOST, which is outside the /gem_sw export, so clients would not see them.
# Mount it in and export it as a second path.
#
# Raw docker arguments, split on whitespace by systemd. No quotes, no spaces
# in paths.
EXTRA_DOCKER_ARGS=-v /gemini:/gemini:rw

# Created 0777 at start, matching /gem_sw. Without this docker would create the
# bind source itself as root:root 0755 whenever the unit starts before gmoscc
# is installed.
EXTRA_EXPORT_DIRS=/gemini
