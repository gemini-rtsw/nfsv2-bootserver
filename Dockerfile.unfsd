FROM rockylinux:9

# Install EPEL and build dependencies
RUN dnf install -y epel-release && \
    dnf install -y \
    gcc \
    make \
    rpcbind \
    net-tools \
    vim \
    iproute \
    procps-ng \
    git \
    flex \
    bison \
    libtirpc \
    libtirpc-devel \
    autoconf \
    automake \
    && dnf clean all

# Build unfsd (userspace NFS daemon with NFSv2 support)
WORKDIR /tmp
RUN git clone https://github.com/unfs3/unfs3.git && \
    cd unfs3 && \
    ./bootstrap && \
    ./configure --enable-nfsv2 && \
    make && \
    make install

# Create NFS export directory
RUN mkdir -p /nfs/vxworks && \
    chmod -R 777 /nfs/vxworks

# Note: rsh/rlogin services not included in this build as they're not available in Rocky 9 repos
# If needed, they can be compiled separately or accessed via the host system

# Add startup script
COPY entrypoint-unfsd.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 111 111/udp 2049 2049/udp 514 513 512

ENTRYPOINT ["/entrypoint.sh"]

