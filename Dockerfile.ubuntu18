FROM ubuntu:18.04

# Ubuntu 18.04 (Bionic) had unfsd in repos
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    unfsd \
    rpcbind \
    net-tools \
    iproute2 \
    procps \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Create NFS export directory
RUN mkdir -p /nfs/vxworks && \
    chmod -R 777 /nfs/vxworks

# Add startup script
COPY entrypoint-unfsd.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 111 111/udp 2049 2049/udp

ENTRYPOINT ["/entrypoint.sh"]

